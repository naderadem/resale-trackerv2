# Copy this file to .env and fill in your own values. Never commit .env.
#
# eBay Developer credentials (see README for how to get these).
EBAY_APP_ID=
EBAY_CERT_ID=

# Postgres connection. These defaults match docker-compose.yml, so
# `docker compose up -d` + the defaults below work together out of the box.
# Set DATABASE_URL instead to override with a single connection string
# (e.g. for a hosted Postgres) -- it takes precedence over the POSTGRES_*
# vars below if set.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=resale_tracker
POSTGRES_USER=resale_tracker
POSTGRES_PASSWORD=resale_tracker

# Matcher / pricing tuning (all optional -- these are the defaults).
# MATCH_THRESHOLD=0.72
# MIN_SAMPLE_SIZE=5
# SUSPICIOUS_FLOOR_PCT=0.4
# MIN_SELLER_RATING=95.0
# MIN_PHOTO_COUNT=3

# Discord webhook for `python main.py alert` (Server Settings -> Integrations
# -> Webhooks in the channel you want alerts in). Not required for
# `alert --dry-run`, which only prints.
DISCORD_WEBHOOK_URL=
